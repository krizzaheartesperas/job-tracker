# Copy this file to .env.local and fill in your own Supabase project values.
# Find these in Supabase dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — only needed for scripts/email-pipeline.mjs (local admin scripts).
# This is the "service_role" secret, NOT the anon key. It bypasses Row Level
# Security entirely. Never prefix it with NEXT_PUBLIC_ (that would ship it to
# the browser) and never commit it — .env.local is already gitignored.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Required for the "Import from email" feature (app/api/parse-email-screenshot).
# Server-only — never prefix with NEXT_PUBLIC_.
# GROQ_API_KEY=your-groq-api-key
